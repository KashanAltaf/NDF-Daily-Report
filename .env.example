# Jira sync
JIRA_BASE_URL=https://namipay-team.atlassian.net
JIRA_EMAIL=your.email@company.com
JIRA_API_TOKEN=your_atlassian_api_token
JIRA_PROJECT=PB
JIRA_OPEN_BUGS_SINCE=2026-06-30
# Optional: textfields ~ "posworker*"
# JIRA_TEXT_FILTER=

# Azure DevOps sync
ADO_ORG=verokeinc
ADO_PROJECT=Nami-POSWorker-1.0
ADO_PAT=your_azure_devops_pat
# Optional: comma-separated test plan IDs (defaults to project POS test plans)
# ADO_TEST_PLAN_IDS=14617,14359,13962,13960
# Optional: open-bugs cutoff (defaults to JIRA_OPEN_BUGS_SINCE or 2026-06-30)
# ADO_OPEN_BUGS_SINCE=2026-06-30
# Optional: Jira custom field for UAT GitHub PR URL (defaults to customfield_10649)
# JIRA_GITHUB_PR_URL_UAT_FIELD=customfield_10649
# ADO status map (same report roles as Jira): New=Open, Closed/Resolved=Fixed, Active/Reopened=In retest, Rejected=excluded

REPORT_PORT=8768
