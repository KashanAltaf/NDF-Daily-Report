# Jira sync
JIRA_BASE_URL=https://namipay-team.atlassian.net
# Comma-separated Jira account emails
JIRA_EMAIL=kashan.altaf@veroke.com,v-kashan.altaf@namipay.com.sa
# Microsoft Authenticator login email (defaults to first JIRA_EMAIL if unset)
AUTH_EMAIL=kashan.altaf@veroke.com
# Token for kashan.altaf@veroke.com (leave this as the existing Vercel token)
JIRA_API_TOKEN=your_atlassian_api_token
# Token for v-kashan.altaf@namipay.com.sa
JIRA_API_TOKEN_NAMIPAY=your_namipay_atlassian_api_token
JIRA_PROJECT=PB,POR
JIRA_OPEN_BUGS_SINCE=2026-01-01
# Enhancements + Sales Portal Enhancements cutoff (defaults to 2026-01-01)
JIRA_ENHANCEMENTS_SINCE=2026-01-01
# Optional: textfields ~ "posworker*"
# JIRA_TEXT_FILTER=

# Azure DevOps sync
ADO_ORG=verokeinc
ADO_PROJECT=Nami-POSWorker-1.0
ADO_PAT=your_azure_devops_pat
# Optional: comma-separated test plan IDs (defaults to project POS test plans)
# ADO_TEST_PLAN_IDS=14617,14359,13962,13960
# Optional: open-bugs cutoff (defaults to JIRA_OPEN_BUGS_SINCE or 2026-01-01)
# ADO_OPEN_BUGS_SINCE=2026-01-01
# Optional: Jira custom field for UAT GitHub PR URL (defaults to customfield_10649)
# JIRA_GITHUB_PR_URL_UAT_FIELD=customfield_10649
# ADO status map (same report roles as Jira): New=Open, Closed/Resolved=Fixed, Active/Reopened=In retest, Rejected=excluded

REPORT_PORT=8768

# Microsoft Authenticator login (restricts report + API when configured)
# AUTH_SECRET: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=your_random_secret_at_least_16_chars
# AUTH_TOTP_SECRET: npm run auth:totp-setup (then add account in Microsoft Authenticator)
AUTH_TOTP_SECRET=your_base32_totp_secret
